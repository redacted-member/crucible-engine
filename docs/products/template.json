{
  "format": "crucible-product",
  "version": 1,
  "id": "my.product",
  "name": "My Product",
  "description": "Starter product: the classic voice with 2 oscillators, 2 filters and 6 macros, and a short effects chain of current modules only. Copy it, rename the id, then add or remove instances. Legacy modules (see the README table) are not used.",
  "layout": {
    "oscillators": 2,
    "filters": 2,
    "macros": 6
  },
  "voice": "classic",
  "fx": {
    "instances": [
      {
        "id": "saturator",
        "type": "fx.saturator"
      },
      {
        "id": "ensemble",
        "type": "fx.ensemble"
      },
      {
        "id": "delay",
        "type": "fx.delay_pro"
      },
      {
        "id": "reverb",
        "type": "fx.reverb_algo"
      },
      {
        "id": "comp",
        "type": "fx.comp_clean"
      },
      {
        "id": "eq",
        "type": "fx.eq_pro"
      },
      {
        "id": "limiter",
        "type": "fx.limiter"
      }
    ],
    "lanes": [
      {
        "id": "main",
        "order": "listed",
        "input": [
          "voices"
        ],
        "chain": [
          "saturator",
          "ensemble",
          "delay",
          "reverb",
          "comp",
          "eq",
          "limiter"
        ]
      }
    ]
  },
  "surface": {
    "expose": "listed",
    "sections": [
      { "id": "sound", "name": "Sound" },
      { "id": "fx", "name": "Effects" }
    ],
    "pages": [
      { "id": "osc1", "name": "Osc 1", "section": "sound", "params": ["osc1_table", "osc1_pos", "osc1_level"] },
      { "id": "filter", "name": "Filter", "section": "sound", "params": ["filter_cutoff", "filter_res"] },
      { "id": "amp", "name": "Amp", "section": "sound", "params": ["amp_attack", "amp_decay", "amp_sustain", "amp_release", "master_gain"] },
      { "id": "saturator", "name": "Saturator", "section": "fx", "params": ["fx_saturator_drive"] }
    ]
  }
}
