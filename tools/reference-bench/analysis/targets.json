{
  "description": "Pass/fail targets for our engine. best_reference = equal to or better than the best measured reference (plus margin); absolute/range = fixed bounds where the references cannot be driven or where a physical definition exists.",
  "targets": [
    { "id": "saw_alias", "group": "Oscillators", "label": "Saw aliasing below 20 kHz, worst note C2..C8", "metric": "tests.osc_saw_n*.alias_audible_db", "agg": "max", "better": "lower", "rule": "best_reference", "margin": 3, "unit": "dB",
      "why": "energy folded into the audible band relative to the harmonics; the best reference keeps folded partials above 20 kHz" },
    { "id": "saw_spur", "group": "Oscillators", "label": "Saw worst spur below 20 kHz, worst note", "metric": "tests.osc_saw_n*.worst_audible_spur_dbc", "agg": "max", "better": "lower", "rule": "best_reference", "margin": 3, "unit": "dBc" },
    { "id": "square_alias", "group": "Oscillators", "label": "Square aliasing below 20 kHz, worst note", "metric": "tests.osc_square_n*.alias_audible_db", "agg": "max", "better": "lower", "rule": "best_reference", "margin": 3, "unit": "dB" },
    { "id": "sine_thdn", "group": "Oscillators", "label": "Sine THD+N, worst note", "metric": "tests.osc_sine_n*.thdn_db", "agg": "max", "better": "lower", "rule": "best_reference", "margin": 3, "unit": "dB" },
    { "id": "saw_bandwidth_c4", "group": "Oscillators", "label": "Saw bandwidth at C4 (harmonics within 3 dB)", "metric": "tests.osc_saw_n60.bandwidth_hz", "better": "higher", "rule": "best_reference", "margin": 1000, "unit": "Hz",
      "why": "how much of the top octave a played saw keeps; a low value sounds dull and drops harmonics when the mip level switches" },
    { "id": "saw_bandwidth_min", "group": "Oscillators", "label": "Saw bandwidth, worst note C2..C8", "metric": "tests.osc_saw_n*.bandwidth_hz", "agg": "min", "better": "higher", "rule": "best_reference", "margin": 1000, "unit": "Hz" },
    { "id": "saw_shape", "group": "Oscillators", "label": "Saw harmonic error below 10 kHz (rms, C4)", "metric": "tests.osc_saw_n60.harmonic_error_db_rms", "better": "lower", "rule": "absolute", "threshold": 0.1, "unit": "dB" },
    { "id": "tuning", "group": "Oscillators", "label": "Tuning error, worst of all oscillator tests", "metric": "derived.tuning_max_abs_cents", "better": "lower", "rule": "absolute", "threshold": 0.1, "unit": "cents" },
    { "id": "dc", "group": "Oscillators", "label": "DC offset, worst oscillator test", "metric": "tests.osc_*.dc_dbfs", "agg": "max", "better": "lower", "rule": "absolute", "threshold": -70, "unit": "dBFS" },

    { "id": "unison_alias", "group": "Unison and wavetables", "label": "8-voice unison aliasing at C7", "metric": "tests.unison8_n96.alias_audible_db", "better": "lower", "rule": "best_reference", "margin": 6, "unit": "dB" },
    { "id": "unison_corr", "group": "Unison and wavetables", "label": "8-voice unison L/R correlation (default width)", "metric": "tests.unison8_n96.correlation", "better": "lower", "rule": "info", "unit": "",
      "why": "Serum spreads unison fully (correlation near 0, mono sum -3 dB); a design choice, reported for calibration" },
    { "id": "unison_mono", "group": "Unison and wavetables", "label": "8-voice unison mono-sum loss", "metric": "tests.unison8_n96.mono_loss_db", "better": "higher", "rule": "absolute", "threshold": -4, "unit": "dB",
      "why": "wide unison must not collapse in mono by more than 4 dB" },
    { "id": "wt_sweep_p90", "group": "Unison and wavetables", "label": "Wavetable sweep aliasing (90th percentile), C7", "metric": "tests.wtsweep_n96.alias_audible_db_p90", "better": "lower", "rule": "best_reference", "margin": 3, "unit": "dB" },
    { "id": "wt_sweep_steps", "group": "Unison and wavetables", "label": "Wavetable sweep level jumps between 21 ms frames", "metric": "tests.wtsweep_n*.level_step_db_max", "agg": "max", "better": "lower", "rule": "absolute", "threshold": 0.5, "unit": "dB",
      "why": "frame-to-frame level steps while morphing indicate zipper noise or stepped frames" },

    { "id": "lp24_slope", "group": "Filters", "label": "24 dB low-pass slope (1 kHz)", "metric": "tests.filter_lp24_1k.slope_db_per_oct", "rule": "range", "range": [-27, -22], "unit": "dB/oct" },
    { "id": "lp12_slope", "group": "Filters", "label": "12 dB low-pass slope (1 kHz)", "metric": "tests.filter_lp12_1k.slope_db_per_oct", "rule": "range", "range": [-14, -11], "unit": "dB/oct" },
    { "id": "lp24_tracking", "group": "Filters", "label": "24 dB low-pass resonant peak error, 1-12 kHz", "metrics": ["tests.filter_lp24_1k_r90.cutoff_error_cents", "tests.filter_lp24_4000_r90.cutoff_error_cents", "tests.filter_lp24_8000_r90.cutoff_error_cents", "tests.filter_lp24_12000_r90.cutoff_error_cents"], "agg": "max_abs", "better": "lower", "rule": "best_reference", "margin": 5, "unit": "cents",
      "why": "a tuned zero-delay-feedback design keeps the resonant peak on the nominal cutoff up to the top of the range" },
    { "id": "lp12_tracking", "group": "Filters", "label": "12 dB low-pass resonant peak error at 1 kHz", "metric": "tests.filter_lp12_1k_r90.cutoff_error_cents", "abs": true, "better": "lower", "rule": "best_reference", "margin": 5, "unit": "cents" },
    { "id": "res_peak", "group": "Filters", "label": "Maximum resonance peak, 24 dB low-pass", "metric": "tests.filter_lp24_1k_r100.peak_gain_db", "better": "higher", "rule": "best_reference", "margin": 6, "unit": "dB",
      "why": "how close to self-oscillation the top of the resonance range gets" },
    { "id": "res_passband", "group": "Filters", "label": "Passband loss at maximum resonance, 24 dB low-pass", "metric": "tests.filter_lp24_1k_r100.passband_gain_db", "better": "lower", "rule": "info", "unit": "dB",
      "why": "Serum lowers the passband by about 14 dB at full resonance (gain compensation); a voicing choice" },
    { "id": "ladder_selfosc_pitch", "group": "Filters", "label": "Ladder self-oscillation pitch error", "metric": "tests.selfosc_ladder.pitch_error_cents", "abs": true, "better": "lower", "rule": "absolute", "threshold": 10, "unit": "cents" },
    { "id": "filter_finite", "group": "Filters", "label": "Non-finite samples in any render", "metric": "tests.*.non_finite_samples", "agg": "max", "better": "lower", "rule": "absolute", "threshold": 0, "unit": "" },

    { "id": "env_attack", "group": "Envelopes and pitch", "label": "Attack time accuracy (1 s nominal)", "metric": "tests.env_long.attack_ratio", "rule": "range", "range": [0.9, 1.1], "unit": "x nominal",
      "why": "both references reach the peak within 2 % of the nominal attack" },
    { "id": "env_release", "group": "Envelopes and pitch", "label": "Release time to -60 dB (1.5 s nominal)", "metric": "tests.env_long.release_ratio_60db", "rule": "range", "range": [0.85, 1.1], "unit": "x nominal",
      "why": "Serum's release time is the time to -60 dB (measured 0.99x)" },
    { "id": "env_sustain", "group": "Envelopes and pitch", "label": "Sustain level error (-12 dB nominal)", "metric": "tests.env_long.sustain_error_db", "abs": true, "better": "lower", "rule": "absolute", "threshold": 0.5, "unit": "dB" },
    { "id": "env_latency", "group": "Envelopes and pitch", "label": "Note-on to output (-60 dB) latency", "metric": "tests.env_fast.latency_minus60db_ms", "better": "lower", "rule": "best_reference", "margin": 0.1, "unit": "ms" },
    { "id": "env_click", "group": "Envelopes and pitch", "label": "Onset click (energy above 2 kHz, sine A4, zero attack)", "metric": "tests.env_fast.onset_hf_db", "better": "lower", "rule": "best_reference", "margin": 6, "unit": "dB" },
    { "id": "bend", "group": "Envelopes and pitch", "label": "Pitch bend error at +/-2 semitones", "metric": "tests.bend.max_error_cents", "better": "lower", "rule": "absolute", "threshold": 0.1, "unit": "cents" },
    { "id": "idle", "group": "Envelopes and pitch", "label": "Idle output level (no notes)", "metric": "tests.idle.rms_dbfs", "better": "lower", "rule": "absolute", "threshold": -140, "unit": "dBFS" },
    { "id": "tail", "group": "Envelopes and pitch", "label": "Residual output 1-3 s after release", "metric": "tests.tail.rms_dbfs", "better": "lower", "rule": "absolute", "threshold": -140, "unit": "dBFS",
      "why": "both references output exact zeros after the release; denormal-free silence also keeps idle CPU low" },

    { "id": "lfo_rate", "group": "LFO and FX (references cannot be driven)", "label": "LFO rate error, worst shape", "metric": "tests.lfo_*.rate_error_pct", "agg": "max_abs", "better": "lower", "rule": "absolute", "threshold": 0.5, "unit": "%" },
    { "id": "lfo_shape", "group": "LFO and FX (references cannot be driven)", "label": "LFO shape correlation, worst shape", "metric": "tests.lfo_*.shape_correlation", "agg": "min", "better": "higher", "rule": "absolute", "threshold": 0.98, "unit": "" },
    { "id": "reverb_rt60", "group": "LFO and FX (references cannot be driven)", "label": "Reverb T30 against nominal decay", "metrics": ["tests.fx_reverb_1s.rt60_ratio", "tests.fx_reverb_3s.rt60_ratio"], "agg": "min", "rule": "range", "range": [0.9, 1.1], "unit": "x nominal" },
    { "id": "reverb_decorrelation", "group": "LFO and FX (references cannot be driven)", "label": "Reverb tail L/R correlation", "metrics": ["tests.fx_reverb_1s.tail_correlation", "tests.fx_reverb_3s.tail_correlation"], "agg": "max_abs", "better": "lower", "rule": "absolute", "threshold": 0.3, "unit": "" },
    { "id": "delay_time", "group": "LFO and FX (references cannot be driven)", "label": "Delay time error", "metric": "tests.fx_delay.time_error_ms", "abs": true, "better": "lower", "rule": "absolute", "threshold": 0.5, "unit": "ms" },
    { "id": "delay_feedback", "group": "LFO and FX (references cannot be driven)", "label": "Delay feedback error per repeat", "metric": "tests.fx_delay.feedback_error_db", "abs": true, "better": "lower", "rule": "absolute", "threshold": 0.5, "unit": "dB" },
    { "id": "eq_gain", "group": "LFO and FX (references cannot be driven)", "label": "EQ band gain error (+6 dB bands)", "metrics": ["tests.fx_eq_6db.band_120hz_error_db", "tests.fx_eq_6db.band_1000hz_error_db", "tests.fx_eq_6db.band_6000hz_error_db"], "agg": "max_abs", "better": "lower", "rule": "absolute", "threshold": 0.5, "unit": "dB" },
    { "id": "comp_ratio", "group": "LFO and FX (references cannot be driven)", "label": "Compressor static ratio (4:1 nominal)", "metric": "derived.compressor.ratio_measured", "rule": "range", "range": [3.6, 4.4], "unit": ":1" },

    { "id": "selfosc_tracking", "group": "Analog behaviour (pending)", "status": "pending", "label": "Self-oscillation pitch error, 40 Hz to 8 kHz", "metric": "derived.selfosc_track.max_abs_cents", "better": "lower", "rule": "absolute", "threshold": 5, "unit": "cents",
      "why": "analytic: a self-oscillating filter plays its cutoff; 5 cents at High quality, 15 at Draft (engine plan 3.1)" },
    { "id": "selfosc_amplitude", "group": "Analog behaviour (pending)", "status": "pending", "label": "Self-oscillation level spread across the keyboard", "metric": "derived.selfosc_track.amplitude_spread_db", "better": "lower", "rule": "absolute", "threshold": 3, "unit": "dB" },
    { "id": "bassloss_ladder", "group": "Analog behaviour (pending)", "status": "pending", "label": "Ladder bass loss against -20 log10(1+k)", "metric": "derived.bassloss.ladder_error_db", "better": "lower", "rule": "absolute", "threshold": 0.5, "unit": "dB",
      "why": "analytic from the ladder feedback law; compensated models are held to 0 dB loss instead" },
    { "id": "resonance_compression", "group": "Analog behaviour (pending)", "status": "pending", "label": "Resonant peak gain falls as the input level rises", "metric": "derived.res_level_dependence.monotonic", "rule": "range", "range": [1, 1], "unit": "" },
    { "id": "sat_even_symmetric", "group": "Analog behaviour (pending)", "status": "pending", "label": "Symmetric saturator: even harmonics", "metric": "tests.sat_1k_d100.even_db", "better": "lower", "rule": "absolute", "threshold": -90, "unit": "dB" },
    { "id": "drift_std", "group": "Analog behaviour (pending)", "status": "pending", "label": "Drift standard deviation against the programmed value", "metric": "derived.drift_stats.std_error_pct", "abs": true, "better": "lower", "rule": "absolute", "threshold": 10, "unit": "%" },
    { "id": "drift_tau", "group": "Analog behaviour (pending)", "status": "pending", "label": "Drift time constant against the programmed value", "metric": "derived.drift_stats.tau_error_pct", "abs": true, "better": "lower", "rule": "absolute", "threshold": 20, "unit": "%" },
    { "id": "drift_psd", "group": "Analog behaviour (pending)", "status": "pending", "label": "Drift PSD slope above the corner", "metric": "derived.drift_stats.psd_slope", "rule": "range", "range": [-2.3, -1.7], "unit": "" },
    { "id": "env_rc_residual", "group": "Analog behaviour (pending)", "status": "pending", "label": "RC envelope: exponential fit residual", "metrics": ["tests.env_rc.attack_residual_pct", "tests.env_rc.decay_residual_pct", "tests.env_rc.release_residual_pct"], "agg": "max", "better": "lower", "rule": "absolute", "threshold": 0.5, "unit": "%" },
    { "id": "env_rc_peak", "group": "Analog behaviour (pending)", "status": "pending", "label": "RC envelope: time to peak against the attack setting", "metric": "tests.env_rc.peak_time_error_pct", "abs": true, "better": "lower", "rule": "absolute", "threshold": 2, "unit": "%" },
    { "id": "env_rc_retrigger", "group": "Analog behaviour (pending)", "status": "pending", "label": "RC envelope: retrigger step", "metric": "tests.env_rc_retrigger.retrigger_step_db", "better": "lower", "rule": "absolute", "threshold": -83, "unit": "dB" },
    { "id": "voice_pitch_spread", "group": "Analog behaviour (pending)", "status": "pending", "label": "Voice-card pitch spread, largest deviation", "metric": "tests.voice_variance.pitch_max_abs_cents", "better": "lower", "rule": "absolute", "threshold": 15, "unit": "cents",
      "why": "bounded and centred; the mean must stay near zero (tolerance row of engine plan 3.1)" },
    { "id": "voice_pitch_mean", "group": "Analog behaviour (pending)", "status": "pending", "label": "Voice-card pitch spread, mean", "metric": "tests.voice_variance.pitch_mean_cents", "abs": true, "better": "lower", "rule": "absolute", "threshold": 1, "unit": "cents" },

    { "id": "cpu_8x8", "group": "CPU", "label": "8 notes x 8 unison, saw (CPU of all threads)", "metric": "tests.cpu_8x8unison.cpu_percent_all_threads", "better": "lower", "rule": "best_reference", "unit": "%",
      "why": "process CPU time of every thread over audio time, best of three runs; Pigments spends about four times its wall time on worker threads" },
    { "id": "cpu_8x8_wall", "group": "CPU", "label": "8 notes x 8 unison, saw (wall time of processBlock)", "metric": "tests.cpu_8x8unison.cpu_percent", "better": "lower", "rule": "info", "unit": "%" },
    { "id": "cpu_16x8", "group": "CPU", "label": "16 notes x 8 unison, saw (CPU of all threads)", "metric": "tests.cpu_16x8unison.cpu_percent_all_threads", "better": "lower", "rule": "best_reference", "unit": "%" },
    { "id": "cpu_8x8f", "group": "CPU", "label": "8 notes x 8 unison, saw, 24 dB low-pass (all threads)", "metric": "tests.cpu_8x8_filter.cpu_percent_all_threads", "better": "lower", "rule": "best_reference", "unit": "%" },
    { "id": "cpu_1", "group": "CPU", "label": "1 note, saw (all threads)", "metric": "tests.cpu_1voice.cpu_percent_all_threads", "better": "lower", "rule": "best_reference", "unit": "%" },
    { "id": "cpu_worst_block", "group": "CPU", "label": "Worst block, 16 notes x 8 unison", "metric": "tests.cpu_16x8unison.worst_block_ms", "better": "lower", "rule": "absolute", "threshold": 5.3, "unit": "ms",
      "why": "half the 10.7 ms block budget at 512 samples / 48 kHz" }
  ]
}
